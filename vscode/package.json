{
  "name": "code-review",
  "displayName": "Code Review",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onCommand:code-review.reviewStaged"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-review.reviewStaged",
        "title": "Review Staged Changes"
      }
    ],
    "configuration": {
      "title": "Code Review",
      "properties": {
        "codeReview.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the reviewer binary"
        },
        "codeReview.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional path patterns to exclude"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
