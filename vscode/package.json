{
  "name": "code-review",
  "displayName": "Code Review",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mubakli/code-review.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:code-review.reviewStaged",
    "onCommand:code-review.setOpenAIAPIKey",
    "onCommand:code-review.clearOpenAIAPIKey",
    "onCommand:code-review.configureAIProvider",
    "onCommand:code-review.selectAIModel",
    "onCommand:code-review.manageAIKey",
    "onCommand:code-review.pauseAutoReview",
    "onCommand:code-review.resumeAutoReview",
    "onView:code-review.reviewView"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension executes a local reviewer binary."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "code-review.reviewStaged",
        "title": "Review Staged Changes",
        "category": "Code Review",
        "icon": "$(play)"
      },
      {
        "command": "code-review.openStagedDiff",
        "title": "Open AI Review Diff",
        "category": "Code Review"
      },
      {
        "command": "code-review.configureAIProvider",
        "title": "Configure AI Provider",
        "category": "Code Review"
      },
      {
        "command": "code-review.selectAIModel",
        "title": "Select AI Model",
        "category": "Code Review"
      },
      {
        "command": "code-review.manageAIKey",
        "title": "Manage AI API Key",
        "category": "Code Review"
      },
      {
        "command": "code-review.setOpenAIAPIKey",
        "title": "Set OpenAI API Key",
        "category": "Code Review"
      },
      {
        "command": "code-review.clearOpenAIAPIKey",
        "title": "Clear OpenAI API Key",
        "category": "Code Review"
      },
      {
        "command": "code-review.pauseAutoReview",
        "title": "Pause Automatic Reviews",
        "category": "Code Review"
      },
      {
        "command": "code-review.resumeAutoReview",
        "title": "Resume Automatic Reviews",
        "category": "Code Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-review",
          "title": "Code Review",
          "icon": "media/code-review.svg"
        }
      ]
    },
    "views": {
      "code-review": [
        {
          "id": "code-review.providerView",
          "name": "AI Provider"
        },
        {
          "id": "code-review.reviewView",
          "name": "Review Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "code-review.reviewView",
        "contents": "AI review diffs appear here after an AI-enabled staged review. Local-only findings stay in Problems.\n[Run Review](command:code-review.reviewStaged)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "code-review.configureAIProvider",
          "when": "view == code-review.providerView",
          "group": "navigation"
        },
        {
          "command": "code-review.reviewStaged",
          "when": "view == code-review.reviewView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "code-review.openStagedDiff",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Code Review",
      "properties": {
        "codeReview.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the reviewer binary"
        },
        "codeReview.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional path patterns to exclude"
        },
        "codeReview.provider": {
          "type": "string",
          "enum": ["none", "openai", "deepseek"],
          "enumDescriptions": ["Local review only", "OpenAI Responses API", "DeepSeek Chat Completions API"],
          "default": "none",
          "scope": "resource",
          "description": "Optional AI provider. Local review runs when set to none."
        },
        "codeReview.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "AI model name. Use Configure AI Provider for guided setup."
        },
        "codeReview.autoReview": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Automatically review when the staged Git snapshot changes."
        },
        "codeReview.debounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 300,
          "maximum": 5000,
          "scope": "resource",
          "description": "Quiet period before automatic staged review starts."
        },
        "codeReview.ai.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable optional AI analysis after local review."
        },
        "codeReview.ai.autoReview": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Run configured AI analysis automatically after staged changes."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test out/test/aiReview.test.js out/test/autoReview.test.js out/test/environment.test.js out/test/paths.test.js out/test/protocol.test.js out/test/providers.test.js out/test/stagedFiles.test.js",
    "test:integration": "npm run compile && node out/test/runTest.js",
    "test:all": "npm test && npm run test:integration",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "npm run compile && vsce package --no-dependencies --skip-license --out code-review-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "3.9.2",
    "mocha": "11.3.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
